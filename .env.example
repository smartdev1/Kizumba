# ==============================================================================
#  FRONTEND — Nuxt 4  ·  United Kizdom World Congress
# ==============================================================================
#  1. Copier ce fichier : cp .env.example .env
#  2. Remplir les valeurs ci-dessous
#  3. NE JAMAIS committer le fichier .env  (il est dans .gitignore)
#
#  Pour le backend Laravel → voir backend/.env.example
# ==============================================================================


# ── Serveur Nuxt ───────────────────────────────────────────────────────────────
# Hôte et port sur lesquels Nuxt écoute en production (nuxt start)
# PM2 / Nginx utilise ces valeurs pour router le trafic
NITRO_HOST=127.0.0.1
NITRO_PORT=3000


# ── Connexion vers le backend Laravel ──────────────────────────────────────────
# URL interne serveur→serveur (jamais exposée au navigateur)
# En prod : Laravel tourne sur localhost:8000, non accessible publiquement
# Le frontend proxy toutes les requêtes /api-proxy/* vers cette URL
NUXT_API_BACKEND_URL=http://127.0.0.1:8000/api
