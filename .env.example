# WordPress API Configuration
NUXT_PUBLIC_WP_API_URL=https://your-wordpress-site.com/wp-json

# WooCommerce API Credentials
NUXT_PUBLIC_WC_CONSUMER_KEY=your_consumer_key_here
NUXT_PUBLIC_WC_CONSUMER_SECRET=your_consumer_secret_here

# WordPress Authentication Token (for posting updates)
NUXT_PUBLIC_WP_TOKEN=your_wordpress_token_here