# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND — Nuxt 3
# ──────────────────────────────────────────────────────────────────────────────

# URL de base de l'API Laravel (sans slash final)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND — Laravel  (fichier : backend/.env)
# ──────────────────────────────────────────────────────────────────────────────

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kizumba
DB_USERNAME=root
DB_PASSWORD=

# PayDunya
PAYDUNYA_MODE=test                  # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME="United Kizdom World Congress"
PAYDUNYA_STORE_TAGLINE="Festival de danse kizomba"
PAYDUNYA_STORE_ADDRESS="Cotonou, Bénin"
PAYDUNYA_RETURN_URL=https://votre-site.com/checkout
PAYDUNYA_CANCEL_URL=https://votre-site.com/shop
PAYDUNYA_CALLBACK_URL=https://votre-site.com/api/webhooks/paydunya

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@united-kizdom-world-congress.com"
MAIL_FROM_NAME="United Kizdom World Congress"

# App
APP_URL=http://localhost:8000
APP_KEY=                            # généré par : php artisan key:generate
FRONTEND_URL=http://localhost:3000  # pour CORS