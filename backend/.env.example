# ==============================================================================
#  BACKEND — Laravel 13  ·  United Kizdom World Congress
# ==============================================================================
#  1. Copier ce fichier : cp .env.example .env
#  2. Remplir TOUTES les valeurs marquées [REQUIRED]
#  3. NE JAMAIS committer le fichier .env  (il est dans .gitignore)
#  4. Après modification : php artisan config:clear && php artisan optimize
# ==============================================================================


# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="United Kizdom World Congress"
APP_ENV=production              # local | production
APP_KEY=                        # [REQUIRED] générer : php artisan key:generate
APP_DEBUG=false                 # TOUJOURS false en production
APP_URL=https://votre-domaine.com  # [REQUIRED] URL publique du site (sans slash final)

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12


# ── Logs ───────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                 # debug en local, error en production


# ── Base de données MySQL ──────────────────────────────────────────────────────
DB_CONNECTION=mysql             # [REQUIRED]
DB_HOST=127.0.0.1               # [REQUIRED] hôte MySQL LWS (ex: localhost)
DB_PORT=3306
DB_DATABASE=kizumba             # [REQUIRED] nom de la base de données
DB_USERNAME=                    # [REQUIRED] utilisateur MySQL
DB_PASSWORD=                    # [REQUIRED] mot de passe MySQL


# ── Session & Cache ────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database


# ── Queue ──────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database       # Les emails sont envoyés en file d'attente


# ── CORS — Frontend autorisé ───────────────────────────────────────────────────
# URL publique du frontend Nuxt (utilisée par cors.php)
# En production : même domaine que APP_URL (Nuxt proxie les requêtes API)
FRONTEND_URL=https://votre-domaine.com  # [REQUIRED] — même valeur que APP_URL


# ── PayDunya — Paiement en ligne ───────────────────────────────────────────────
PAYDUNYA_MODE=test              # [REQUIRED] test | live  — mettre "live" en prod

# Clés TEST (obtenues sur https://app.paydunya.com)
PAYDUNYA_MASTER_KEY=            # [REQUIRED]
PAYDUNYA_PRIVATE_KEY=           # [REQUIRED]
PAYDUNYA_TOKEN=                 # [REQUIRED]

PAYDUNYA_STORE_NAME="United Kizdom World Congress"
PAYDUNYA_STORE_TAGLINE="Festival de danse kizomba"
PAYDUNYA_STORE_ADDRESS="Cotonou, Bénin"

# URLs de redirection après paiement (doit correspondre à APP_URL)
PAYDUNYA_RETURN_URL="${APP_URL}/checkout"
PAYDUNYA_CANCEL_URL="${APP_URL}/shop"
PAYDUNYA_CALLBACK_URL="${APP_URL}/api/webhooks/paydunya"  # [REQUIRED] webhook PayDunya


# ── Email (SMTP) ───────────────────────────────────────────────────────────────
MAIL_MAILER=smtp                # [REQUIRED]
MAIL_HOST=                      # [REQUIRED] ex: smtp.gmail.com | mail.lws.fr
MAIL_PORT=587                   # 587 (TLS) ou 465 (SSL) ou 25
MAIL_USERNAME=                  # [REQUIRED] adresse email
MAIL_PASSWORD=                  # [REQUIRED] mot de passe ou app password
MAIL_SCHEME=tls                 # tls | ssl | null
MAIL_FROM_ADDRESS="noreply@votre-domaine.com"  # [REQUIRED]
MAIL_FROM_NAME="United Kizdom World Congress"


# ── Compte admin initial ────────────────────────────────────────────────────────
# Utilisé par DatabaseSeeder lors du premier déploiement
# Changer le mot de passe immédiatement après la mise en prod !
ADMIN_NAME="Admin UKWC"
ADMIN_EMAIL=                    # [REQUIRED] votre email admin
ADMIN_PASSWORD=                 # [REQUIRED] mot de passe fort (min 12 caractères)


# ── Système (ne pas modifier sauf besoin) ──────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
